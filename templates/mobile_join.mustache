{{!
    @template local_oksigeniafamily/mobile_join

    «For your family» in the app: the student shows this screen, and their family scans the QR with their own phone. A
    template the app compiles: everything in it is the plugin's own words and the QR's path, made inert. What the QR
    needs to be read (black on a white tile, in dark mode too) is written on it: a page opened from another plugin
    (Oksigenia Aty's «Invite another adult») does not get this plugin's sheet, and the app drops the spaces between tags.

    Context variables required for this template:
    * As local_oksigeniafamily/join.

    Example context (json):
    {
        "intro": "Show this to your family.", "qrsvg": "", "codelabel": "Your code", "code": "ABCD-EFGH",
        "addresslabel": "Or open", "address": "example.org/family", "expires": "It works until 2 January 2027.",
        "hasstatus": false, "status": "", "care": "Keep it for your family.", "twophones": false, "phones": [],
        "steps": [{"kind": "scan", "text": "Point your phone's camera at the QR."}]
    }
}}
<div class="ion-padding okf-app okf-join">
    <p class="okf-join-intro">{{intro}}</p>
    {{#hasstatus}}<p class="okf-join-status">{{status}}</p>{{/hasstatus}}
    <div class="okf-join-qr" style="width: 240px; max-width: 80%; margin: 12px auto 16px; padding: 12px; border-radius: 16px; background: #fff; color: #000;">{{{qrsvg}}}</div>
    <p class="okf-join-codeline" style="margin: 4px 0 0; text-align: center;"><span class="okf-join-label" style="display: block; color: var(--ion-color-medium);">{{codelabel}}</span><b class="okf-join-value" style="display: block; font-size: 1.5rem; letter-spacing: .08em;">{{code}}</b></p>
    <p class="okf-join-codeline" style="margin: 10px 0 0; text-align: center;"><span class="okf-join-label" style="display: block; color: var(--ion-color-medium);">{{addresslabel}}</span><b style="display: block;">{{address}}</b></p>
    <p class="okf-join-until" style="margin: 10px 0 0; text-align: center; color: var(--ion-color-medium); font-size: .9rem;">{{expires}}</p>
    {{#twophones}}
    {{#phones}}
    <h3 class="okf-join-phone">{{name}}</h3>
    <ol class="okf-join-steps">{{#steps}}<li>{{text}}</li>{{/steps}}</ol>
    {{/phones}}
    {{/twophones}}
    {{^twophones}}<ol class="okf-join-steps">{{#steps}}<li>{{text}}</li>{{/steps}}</ol>{{/twophones}}
    <p class="okf-join-care">{{care}}</p>
</div>
