{{!
    @template local_oksigeniafamily/join

    «For your family» on the site: the QR the family scans from this screen with their own phone, the code and the short
    address to type it, and the steps, one list per phone where they differ.

    Context variables required for this template:
    * intro, qrsvg, codelabel, code, addresslabel, address, expires, hasstatus, status, care - The page.
    * twophones, phones - Each with name and steps (kind, text), where iPhone and Android differ.
    * steps - The steps, where they do not.

    Example context (json):
    {
        "intro": "Show this to your family.", "qrsvg": "", "codelabel": "Your code", "code": "ABCD-EFGH",
        "addresslabel": "Or open", "address": "example.org/family", "expires": "It works until 2 January 2027.",
        "hasstatus": false, "status": "", "care": "Keep it for your family.", "twophones": false, "phones": [],
        "steps": [{"kind": "scan", "text": "Point your phone's camera at the QR."}]
    }
}}
<div class="local-oksigeniafamily okf-join">
    <p class="okf-join-intro">{{intro}}</p>
    {{#hasstatus}}<p class="okf-join-status">{{status}}</p>{{/hasstatus}}
    <div class="okf-join-code">
        <div class="okf-join-qr">{{{qrsvg}}}</div>
        <div class="okf-join-what">
            <div class="okf-join-label">{{codelabel}}</div>
            <div class="okf-join-value">{{code}}</div>
            <div class="okf-join-label">{{addresslabel}}</div>
            <div class="okf-join-address">{{address}}</div>
            <div class="okf-join-until">{{expires}}</div>
        </div>
    </div>
    {{#twophones}}
    <div class="okf-join-phones">
        {{#phones}}
        <section class="okf-join-phone">
            <h3>{{name}}</h3>
            <ol>{{#steps}}<li>{{text}}</li>{{/steps}}</ol>
        </section>
        {{/phones}}
    </div>
    {{/twophones}}
    {{^twophones}}<ol class="okf-join-steps">{{#steps}}<li>{{text}}</li>{{/steps}}</ol>{{/twophones}}
    <p class="okf-join-care">{{care}}</p>
</div>
