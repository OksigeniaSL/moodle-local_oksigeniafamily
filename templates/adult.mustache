{{!
    @template local_oksigeniafamily/adult

    An adult by hand: the form beside what it means.

    Context variables required for this template:
    * nav - See local_oksigeniafamily/nav.
    * backurl - Where to go back to.
    * form - The form, as HTML.
    * isnew - Whether this starts a new family.
    * prefix - The site's country code.

    Example context (json):
    {
        "nav": {"items": [{"url": "#", "label": "Families", "current": true}]},
        "backurl": "#", "form": "<p>The form</p>", "isnew": true, "prefix": "+1"
    }
}}
<div class="local-oksigeniafamily okf-adult">
    <div class="okf-head">
        {{#nav}}{{> local_oksigeniafamily/nav}}{{/nav}}
        <a class="btn btn-secondary" href="{{backurl}}">{{#str}} family:back, local_oksigeniafamily {{/str}}</a>
    </div>
    <div class="okf-cols">
        <section class="okf-card">{{{form}}}</section>
        <aside class="okf-card okf-side">
            {{#isnew}}<p>{{#str}} adult:help:new, local_oksigeniafamily {{/str}}</p>{{/isnew}}
            <p>{{#str}} adult:help:phone, local_oksigeniafamily, {{prefix}} {{/str}}</p>
            <p>{{#str}} adult:help:account, local_oksigeniafamily {{/str}}</p>
            <p>{{#str}} adult:help:nothing, local_oksigeniafamily {{/str}}</p>
        </aside>
    </div>
</div>
