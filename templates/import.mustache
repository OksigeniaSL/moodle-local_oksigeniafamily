{{!
    @template local_oksigeniafamily/import

    The first step of an import: the file, beside what it should look like.

    Context variables required for this template:
    * nav - See local_oksigeniafamily/nav.
    * action, sesskey - For the form.
    * error - What was wrong with the file, if anything.
    * sampleurl - A file to start from.
    * columns - Each with name, help and required.

    Example context (json):
    {
        "nav": {"items": [{"url": "#", "label": "Import", "current": true}]},
        "action": "#", "sesskey": "abc", "error": "", "sampleurl": "#",
        "columns": [{"name": "family", "help": "The family's key.", "required": true}]
    }
}}
<div class="local-oksigeniafamily okf-import">
    <div class="okf-head">
        {{#nav}}{{> local_oksigeniafamily/nav}}{{/nav}}
    </div>
    <p class="okf-lede">{{#str}} import:lede, local_oksigeniafamily {{/str}}</p>
    <div class="okf-cols">
        <section class="okf-card">
            {{#error}}<p class="okf-bad" role="alert">{{error}}</p>{{/error}}
            <form method="post" action="{{action}}" enctype="multipart/form-data">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label class="okf-drop" for="okf-file">
                    <span class="okf-strong">{{#str}} import:file, local_oksigeniafamily {{/str}}</span>
                    <span class="okf-line">{{#str}} import:file_help, local_oksigeniafamily {{/str}}</span>
                    <input id="okf-file" type="file" name="csvfile" accept=".csv,.txt,text/csv" required>
                </label>
                <label class="okf-check">
                    <input type="checkbox" name="complete" value="1">
                    <span>
                        <span class="okf-strong">{{#str}} import:complete, local_oksigeniafamily {{/str}}</span>
                        <span class="okf-line">{{#str}} import:complete_help, local_oksigeniafamily {{/str}}</span>
                    </span>
                </label>
                <button type="submit" class="btn btn-primary">{{#str}} import:seepreview, local_oksigeniafamily {{/str}}</button>
                <p class="okf-line okf-note">{{#str}} import:nothingyet, local_oksigeniafamily {{/str}}</p>
            </form>
        </section>
        <aside class="okf-card okf-side">
            <h3>{{#str}} import:format, local_oksigeniafamily {{/str}}</h3>
            <p>{{#str}} import:format_text, local_oksigeniafamily {{/str}}</p>
            <dl class="okf-columns">
                {{#columns}}
                <dt><code>{{name}}</code>{{#required}} <span class="okf-chip okf-chip-new">{{#str}} import:required, local_oksigeniafamily {{/str}}</span>{{/required}}</dt>
                <dd>{{help}}</dd>
                {{/columns}}
            </dl>
            <a class="btn btn-secondary" href="{{sampleurl}}">{{#str}} import:sample, local_oksigeniafamily {{/str}}</a>
        </aside>
    </div>
</div>
