{{!
    @template local_oksigeniafamily/mobile_consent

    One request for consent in the Moodle app and in Aty: what the school says and, for each child, what the adult
    answered and two buttons that say what they do, side by side and the same size, with a comment if they want, folded.
    Once answered, the answer with its mark and its date in words, and «Change the answer» instead of the buttons, so that
    one touch no longer changes anything; while changing, «Leave it as it was» (Jujol, 21 November 2026). It has no data of its own: request
    (id, title, until, open, message), sections (adultid, as, children with id, key, fullname, answered, saidyes,
    answertext, yesaria, noaria, savedyes, savedno), comments and changing come as the page's other data, which the app binds, so
    that nothing the school or the family wrote is compiled as part of the template.

    Example context (json):
    {}
}}
{{=<% %>=}}
<ng-container *ngIf="CONTENT_OTHERDATA.request?.id">
    <ion-item lines="none">
        <ion-label class="ion-text-wrap">
            <h1>{{ CONTENT_OTHERDATA.request.title }}</h1>
            <p>{{ CONTENT_OTHERDATA.request.until }}</p>
        </ion-label>
    </ion-item>
    <ion-card>
        <ion-card-content>
            <core-format-text [text]="CONTENT_OTHERDATA.request.message" component="local_oksigeniafamily"
                contextLevel="system" [contextInstanceId]="0"></core-format-text>
        </ion-card-content>
    </ion-card>
    <ng-container *ngFor="let section of CONTENT_OTHERDATA.sections">
        <p class="ion-padding-horizontal">{{ section.as }}</p>
        <ion-card class="okf-consent-hijo" *ngFor="let child of section.children">
            <ion-card-header>
                <ion-card-title>{{ child.fullname }}</ion-card-title>
            </ion-card-header>
            <ion-card-content>
                <ng-container *ngIf="child.answered">
                <okf-dicho class="okf-consent-dicho" [class.okf-consent-no]="!child.saidyes" role="status">
                    <span class="okf-consent-marca" aria-hidden="true">{{ child.saidyes ? '✓' : '✕' }}</span>
                    <p>{{ child.answertext }}</p>
                </okf-dicho>
                </ng-container>
                <ng-container *ngIf="CONTENT_OTHERDATA.request.open">
                    <ng-container *ngIf="child.answered &amp;&amp; !CONTENT_OTHERDATA.changing[child.key]">
                    <okf-boton class="okf-consent-cambiar" role="button" tabindex="0"
                        (click)="CONTENT_OTHERDATA.changing[child.key] = true"
                        (keydown.enter)="CONTENT_OTHERDATA.changing[child.key] = true"><%#str%>consent:changeanswer, local_oksigeniafamily<%/str%></okf-boton>
                    </ng-container>
                    <ng-container *ngIf="!child.answered || CONTENT_OTHERDATA.changing[child.key]">
                        <div class="okf-consent-botones">
                            <ion-button color="success" [attr.aria-label]="child.yesaria" core-site-plugins-call-ws
                                name="local_oksigeniafamily_answer_consent"
                                [params]="{requestid: CONTENT_OTHERDATA.request.id, childuserid: child.id, adultid: section.adultid, answer: 'yes', comment: CONTENT_OTHERDATA.comments[child.key]}"
                                [preSets]="{getFromCache: 0, saveToCache: 0}" [successMessage]="child.savedyes"
                                refreshOnSuccess="true"><ion-icon name="fas-check" aria-hidden="true"></ion-icon><%#str%>consent:yes, local_oksigeniafamily<%/str%></ion-button>
                            <ion-button fill="outline" color="danger" [attr.aria-label]="child.noaria"
                                core-site-plugins-call-ws name="local_oksigeniafamily_answer_consent"
                                [params]="{requestid: CONTENT_OTHERDATA.request.id, childuserid: child.id, adultid: section.adultid, answer: 'no', comment: CONTENT_OTHERDATA.comments[child.key]}"
                                [preSets]="{getFromCache: 0, saveToCache: 0}" [successMessage]="child.savedno"
                                refreshOnSuccess="true"><ion-icon name="fas-xmark" aria-hidden="true"></ion-icon><%#str%>consent:no, local_oksigeniafamily<%/str%></ion-button>
                        </div>
                        <details class="okf-consent-comentario">
                            <summary><%#str%>consent:addcomment, local_oksigeniafamily<%/str%></summary>
                            <ion-textarea class="okf-app-comment" rows="3" maxlength="1000"
                                aria-label="<%#str%>consent:comment, local_oksigeniafamily<%/str%>"
                                [(ngModel)]="CONTENT_OTHERDATA.comments[child.key]"></ion-textarea>
                        </details>
                        <ng-container *ngIf="child.answered">
                        <okf-boton class="okf-consent-dejar" role="button" tabindex="0"
                            (click)="CONTENT_OTHERDATA.changing[child.key] = false"
                            (keydown.enter)="CONTENT_OTHERDATA.changing[child.key] = false"><%#str%>consent:leaveasis, local_oksigeniafamily<%/str%></okf-boton>
                        </ng-container>
                    </ng-container>
                </ng-container>
            </ion-card-content>
        </ion-card>
    </ng-container>
</ng-container>
<ion-list *ngIf="!CONTENT_OTHERDATA.request?.id">
    <ion-item lines="none">
        <ion-label class="ion-text-wrap"><%#str%>consent:nochildren, local_oksigeniafamily<%/str%></ion-label>
    </ion-item>
</ion-list>
