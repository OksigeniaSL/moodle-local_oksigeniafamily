{{!
    @template local_oksigeniafamily/codes

    Whom the codes are for: one search, and the results by kind.

    Context variables required for this template:
    * nav - See local_oksigeniafamily/nav.
    * action, q, searched - The search.
    * people, haspeople - Students, each with name, who and url.
    * places, hasplaces - Courses and groups, each with name, who and url.
    * cohorts, hascohorts - Each with name, who and url.

    Example context (json):
    {
        "nav": {"items": [{"url": "#", "label": "Codes and letters", "current": true}]},
        "action": "#", "q": "ana", "searched": true,
        "people": [{"name": "Ana Ruiz", "who": "ana.ruiz", "url": "#"}], "haspeople": true,
        "places": [], "hasplaces": false,
        "cohorts": [{"name": "Year 5", "who": "28 people", "url": "#"}], "hascohorts": true
    }
}}
<div class="local-oksigeniafamily okf-codes">
    <div class="okf-head">
        {{#nav}}{{> local_oksigeniafamily/nav}}{{/nav}}
    </div>
    <p class="okf-lede">{{#str}} codes:lede, local_oksigeniafamily {{/str}}</p>
    <div class="okf-tools">
        <form class="okf-search" method="get" action="{{action}}" role="search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 L21 21"/></svg>
            <label class="visually-hidden sr-only" for="okf-q">{{#str}} codes:search, local_oksigeniafamily {{/str}}</label>
            <input id="okf-q" type="search" name="q" value="{{q}}" placeholder="{{#str}} codes:search, local_oksigeniafamily {{/str}}">
        </form>
    </div>
    <div class="okf-cards">
        <section class="okf-card">
            <h3>{{#str}} codes:people, local_oksigeniafamily {{/str}}</h3>
            {{#haspeople}}
            <ul class="okf-links">
                {{#people}}<li><a class="nav-link" href="{{url}}"><span class="okf-strong">{{name}}</span><span class="okf-line">{{who}}</span></a></li>{{/people}}
            </ul>
            {{/haspeople}}
            {{^haspeople}}<p class="okf-empty">{{#searched}}{{#str}} codes:nothing, local_oksigeniafamily {{/str}}{{/searched}}{{^searched}}{{#str}} codes:hint:people, local_oksigeniafamily {{/str}}{{/searched}}</p>{{/haspeople}}
        </section>
        <section class="okf-card">
            <h3>{{#str}} codes:places, local_oksigeniafamily {{/str}}</h3>
            {{#hasplaces}}
            <ul class="okf-links">
                {{#places}}<li><a class="nav-link" href="{{url}}"><span class="okf-strong">{{name}}</span><span class="okf-line">{{who}}</span></a></li>{{/places}}
            </ul>
            {{/hasplaces}}
            {{^hasplaces}}<p class="okf-empty">{{#searched}}{{#str}} codes:nothing, local_oksigeniafamily {{/str}}{{/searched}}{{^searched}}{{#str}} codes:hint:places, local_oksigeniafamily {{/str}}{{/searched}}</p>{{/hasplaces}}
        </section>
        <section class="okf-card">
            <h3>{{#str}} codes:cohorts, local_oksigeniafamily {{/str}}</h3>
            {{#hascohorts}}
            <ul class="okf-links">
                {{#cohorts}}<li><a class="nav-link" href="{{url}}"><span class="okf-strong">{{name}}</span><span class="okf-line">{{who}}</span></a></li>{{/cohorts}}
            </ul>
            {{/hascohorts}}
            {{^hascohorts}}<p class="okf-empty">{{#searched}}{{#str}} codes:nothing, local_oksigeniafamily {{/str}}{{/searched}}{{^searched}}{{#str}} codes:hint:cohorts, local_oksigeniafamily {{/str}}{{/searched}}</p>{{/hascohorts}}
        </section>
    </div>
</div>
