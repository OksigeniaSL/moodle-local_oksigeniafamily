{{!
    @template local_oksigeniafamily/notyours

    «Not of my family»: the question with its two answers, or what happened.

    Example context (json):
    {
        "ask": true,
        "question": "Is Laura Gil not of your family?",
        "explain": "If you take Laura Gil out, they stop seeing your children, and the code they joined with stops working.",
        "remove": "Not of my family: take them out",
        "keep": "Yes, they are of my family",
        "keepurl": "https://example.com/",
        "formurl": "https://example.com/local/oksigeniafamily/notyours.php",
        "adultid": 7,
        "sesskey": "x",
        "message": ""
    }
}}
<div class="local-oksigeniafamily-notyours">
    {{#ask}}
    <p class="lead">{{question}}</p>
    <p>{{explain}}</p>
    <form method="post" action="{{formurl}}" class="mb-3">
        <input type="hidden" name="a" value="{{adultid}}">
        <input type="hidden" name="remove" value="1">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" class="btn btn-danger w-100">{{remove}}</button>
    </form>
    <a class="btn btn-outline-secondary w-100" href="{{keepurl}}">{{keep}}</a>
    {{/ask}}
    {{^ask}}
    <p class="lead" role="status">{{message}}</p>
    {{/ask}}
</div>
