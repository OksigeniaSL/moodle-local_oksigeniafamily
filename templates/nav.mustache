{{!
    @template local_oksigeniafamily/nav

    The way between the pages of the school's side.

    Context variables required for this template:
    * items - Each with url, label and current.

    Example context (json):
    {
        "items": [{"url": "#", "label": "Families", "current": true}, {"url": "#", "label": "Import", "current": false}]
    }
}}
<nav class="okf-nav" aria-label="{{#str}} pluginname, local_oksigeniafamily {{/str}}">
    {{#items}}
    <a class="nav-link" href="{{url}}" {{#current}}aria-current="page"{{/current}}>{{label}}</a>
    {{/items}}
</nav>
